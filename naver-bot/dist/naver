import { chromium, BrowserContext, Frame, Page } from "playwright";
import fs from "fs";
import path from "path";
import https from "https";
import http from "http";

const SESSION_DIR = path.join(__dirname, "../sessions");
const TEMP_DIR    = path.join(__dirname, "../temp");
[SESSION_DIR, TEMP_DIR].forEach(d => { if (!fs.existsSync(d)) fs.mkdirSync(d, { recursive: true }); });

const sessionPath = (userId: string) => path.join(SESSION_DIR, `naver_${userId}.json`);

export function naverSessionExists(userId: string): boolean {
  return fs.existsSync(sessionPath(userId));
}

/* ── 봇 탐지 우회 ── */
const ANTI_DETECTION_SCRIPT = `
  Object.defineProperty(navigator, 'webdriver', { get: () => undefined });
  if (!window.chrome) {
    window.chrome = { runtime: {}, loadTimes: () => {}, csi: () => {} };
  }
  Object.defineProperty(navigator, 'plugins', {
    get: () => [1,2,3,4,5].map(() => ({ name: 'Chrome PDF Plugin' }))
  });
  Object.defineProperty(navigator, 'languages', { get: () => ['ko-KR','ko','en-US','en'] });
  const origQuery = window.navigator.permissions?.query;
  if (origQuery) {
    window.navigator.permissions.query = (params) =>
      params.name === 'notifications'
        ? Promise.resolve({ state: Notification.permission })
        : origQuery(params);
  }
`;

const LAUNCH_ARGS = [
  "--no-sandbox",
  "--disable-blink-features=AutomationControlled",
  "--disable-features=IsolateOrigins,site-per-process",
  "--no-first-run",
  "--no-default-browser-check",
];

const UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36";

async function applyAntiDetection(context: BrowserContext) {
  await context.addInitScript(ANTI_DETECTION_SCRIPT);
}

/* ── 이미지 다운로드 ── */
async function downloadImage(url: string, filepath: string): Promise<void> {
  return new Promise((resolve, reject) => {
    const proto = url.startsWith("https") ? https : http;
    const file = fs.createWriteStream(filepath);
    proto.get(url, res => {
      res.pipe(file);
      file.on("finish", () => { file.close(); resolve(); });
    }).on("error", err => { fs.unlink(filepath, () => {}); reject(err); });
  });
}

/* ── 인간형 텍스트 삽입 (문장 단위 랜덤 delay) ── */
async function humanInsertLines(frame: Frame, page: Page, text: string) {
  const lines = text.split("\n");
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    if (line.trim()) {
      // 문장을 청크로 나눠서 삽입 (10~20자 단위)
      const chunks: string[] = [];
      let tmp = "";
      for (const ch of line) {
        tmp += ch;
        if (tmp.length >= Math.floor(Math.random() * 10 + 10)) {
          chunks.push(tmp); tmp = "";
        }
      }
      if (tmp) chunks.push(tmp);

      for (const chunk of chunks) {
        await frame.evaluate((t) => document.execCommand("insertText", false, t), chunk);
        // 청크 사이 랜덤 delay (20~100ms) - 실제 타이핑처럼
        await page.waitForTimeout(Math.floor(Math.random() * 80 + 20));
      }
    }
    if (i < lines.length - 1) {
      await page.keyboard.press("Enter");
      // 줄바꿈 후 가끔 긴 pause (생각하는 척)
      const pause = Math.random() < 0.15
        ? Math.floor(Math.random() * 1500 + 800)  // 15% 확률로 0.8~2.3초
        : Math.floor(Math.random() * 150 + 30);   // 85% 확률로 30~180ms
      await page.waitForTimeout(pause);
    }
  }
}

/* ── 이미지 패턴 계산 ── */
function calcImagePositions(lines: string[], imageCount: number, pattern: "A"|"B"|"C"): number[] {
  const total = lines.length;
  if (imageCount === 0) return [];
  if (pattern === "A") {
    // 중간 1지점
    return [Math.floor(total / 2)];
  } else if (pattern === "B") {
    // 1/3, 2/3 지점
    return [Math.floor(total / 3), Math.floor(total * 2 / 3)];
  } else {
    // C: 균등 분산 (이미지 수에 따라)
    const step = Math.floor(total / (imageCount + 1));
    return Array.from({ length: imageCount }, (_, i) => step * (i + 1));
  }
}

/* ── SE4 이미지 업로드 ── */
async function insertImageToSE4(frame: Frame, page: Page, imgPath: string, caption: string) {
  try {
    // 도구 모음에서 이미지 버튼 클릭
    const imgBtnSels = [
      "button[data-name='image']",
      ".se-toolbar-item-imageUpload button",
      "button[class*='imageUpload']",
      ".se-btn-image-upload",
    ];
    let clicked = false;
    for (const sel of imgBtnSels) {
      try {
        const el = await frame.$(sel);
        if (el) { await frame.click(sel, { timeout: 3000 }); clicked = true; break; }
      } catch {}
    }
    if (!clicked) {
      console.log("[naver] 이미지 버튼 없음, 건너뜀");
      return;
    }
    await page.waitForTimeout(1000);

    // 파일 인풋에 이미지 주입
    const fileInputSels = [
      "input[type='file'][accept*='image']",
      "input[type='file']",
    ];
    for (const sel of fileInputSels) {
      try {
        const el = await frame.$(sel);
        if (el) { await el.setInputFiles(imgPath); break; }
      } catch {
        try {
          const el = await page.$(sel);
          if (el) { await el.setInputFiles(imgPath); break; }
        } catch {}
      }
    }
    await page.waitForTimeout(3000); // 업로드 완료 대기

    // 캡션 입력
    if (caption) {
      const captionSels = [
        ".se-image-caption [contenteditable='true']",
        ".se-caption [contenteditable='true']",
        ".se-component-content .se-text-paragraph [contenteditable]",
      ];
      for (const sel of captionSels) {
        try {
          const el = await frame.$(sel);
          if (el) {
            await frame.click(sel, { timeout: 3000 });
            await page.waitForTimeout(300);
            await frame.evaluate((t) => document.execCommand("insertText", false, t), caption);
            console.log(`[naver] 캡션 입력: ${caption}`);
            break;
          }
        } catch {}
      }
    }
    await page.waitForTimeout(800);
    console.log(`[naver] 이미지 삽입 완료: ${path.basename(imgPath)}`);
  } catch (e) {
    console.log("[naver] 이미지 삽입 실패 (무시):", e);
  }
}

/* ── 영상 삽입 ── */
async function insertVideoToSE4(frame: Frame, page: Page, videoUrl: string) {
  try {
    const videoBtnSels = [
      "button[data-name='video']",
      ".se-toolbar-item-video button",
      "button[class*='video']",
    ];
    for (const sel of videoBtnSels) {
      try {
        const el = await frame.$(sel);
        if (el) {
          await frame.click(sel, { timeout: 3000 });
          await page.waitForTimeout(1000);
          // URL 입력창 찾기
          const urlInputSels = ["input[placeholder*='URL']", "input[placeholder*='주소']", "input[type='url']"];
          for (const uSel of urlInputSels) {
            try {
              const uEl = await frame.$(uSel) || await page.$(uSel);
              if (uEl) {
                await uEl.fill(videoUrl);
                await page.keyboard.press("Enter");
                await page.waitForTimeout(2000);
                console.log(`[naver] 영상 삽입: ${videoUrl}`);
                break;
              }
            } catch {}
          }
          break;
        }
      } catch {}
    }
  } catch (e) {
    console.log("[naver] 영상 삽입 실패 (무시):", e);
  }
}

/* ── 네이버 로그인 + blogId 추출 ── */
export async function saveNaverSession(userId: string, id: string, pw: string): Promise<{ blogId: string }> {
  const browser = await chromium.launch({ headless: false, args: LAUNCH_ARGS, slowMo: 50 });
  const context = await browser.newContext({ userAgent: UA, viewport: { width: 1280, height: 800 }, locale: "ko-KR", timezoneId: "Asia/Seoul" });
  await applyAntiDetection(context);
  const page = await context.newPage();

  try {
    console.log("[naver] 로그인 페이지 진입...");
    await page.goto("https://nid.naver.com/nidlogin.login", { waitUntil: "domcontentloaded", timeout: 30000 });
    await page.waitForTimeout(800);

    await page.evaluate((v) => {
      const el = document.querySelector("#id") as HTMLInputElement;
      if (el) { el.focus(); el.value = v; el.dispatchEvent(new Event("input", { bubbles: true })); }
    }, id);
    await page.waitForTimeout(400);
    await page.evaluate((v) => {
      const el = document.querySelector("#pw") as HTMLInputElement;
      if (el) { el.focus(); el.value = v; el.dispatchEvent(new Event("input", { bubbles: true })); }
    }, pw);
    await page.waitForTimeout(400);

    await page.click(".btn_login").catch(() => page.click("button[type='submit']"));
    console.log("[naver] 로그인 대기 중... (캡차 있으면 직접 풀어주세요)");
    try {
      await page.waitForFunction(() => !location.href.includes("nid.naver.com/nidlogin"), { timeout: 90000 });
    } catch { throw new Error("로그인 시간 초과 (90초)"); }

    await page.waitForTimeout(2000);
    if (page.url().includes("nidlogin")) throw new Error("로그인 실패");
    console.log("[naver] ✅ 로그인 성공");

    let blogId: string | null = null;
    const INVALID_IDS = ["PostList", "BlogHome", "FeedList", "neighborPostList", "TagList", "GoBlogWrite"];

    try {
      await page.goto("https://blog.naver.com/GoBlogWrite.naver", { waitUntil: "domcontentloaded", timeout: 30000 });
      await page.waitForTimeout(3000);
      const m = page.url().match(/[?&]blogId=([a-zA-Z0-9_-]+)/);
      if (m && m[1] && !INVALID_IDS.includes(m[1])) blogId = m[1];
    } catch {}

    if (!blogId) {
      try {
        await page.goto("https://m.blog.naver.com", { waitUntil: "domcontentloaded", timeout: 20000 });
        await page.waitForTimeout(2000);
        const m = page.url().match(/blog\.naver\.com\/([a-zA-Z0-9_-]+)/);
        if (m && m[1] && !INVALID_IDS.includes(m[1])) blogId = m[1];
      } catch {}
    }
    if (!blogId) blogId = id;
    console.log(`[naver] ✅ blogId: ${blogId}`);

    const cookies = await context.cookies();
    fs.writeFileSync(sessionPath(userId), JSON.stringify({ loginId: id, blogId, cookies }, null, 2));
    await browser.close();
    return { blogId };
  } catch (e) {
    await browser.close().catch(() => {});
    throw e;
  }
}

/* ── 네이버 블로그 자동발행 ── */
export async function publishNaver(params: {
  userId: string;
  title: string;
  content: string;
  tags: string[];
  images?: string[];
  captions?: string[];
  imgPattern?: "A"|"B"|"C"|"random";
  videoUrl?: string;
  videoPosition?: "top"|"middle"|"bottom";
}): Promise<string> {
  const {
    userId, title, content, tags,
    images = [], captions = [],
    imgPattern = "random",
    videoUrl = "", videoPosition = "middle",
  } = params;

  // 실제 패턴 결정 (random이면 확률 기반 선택)
  const pattern: "A"|"B"|"C" = imgPattern === "random"
    ? (Math.random() < 0.5 ? "A" : Math.random() < 0.7 ? "B" : "C")
    : imgPattern;

  const sp = sessionPath(userId);
  if (!fs.existsSync(sp)) throw new Error("네이버 세션 없음. 계정 재연결 필요");
  const { blogId, cookies } = JSON.parse(fs.readFileSync(sp, "utf-8"));

  // 이미지 미리 다운로드
  const localImgPaths: string[] = [];
  for (let i = 0; i < images.length; i++) {
    try {
      const ext = images[i].includes(".png") ? "png" : "jpg";
      const imgPath = path.join(TEMP_DIR, `pub_${userId}_${Date.now()}_${i}.${ext}`);
      await downloadImage(images[i], imgPath);
      localImgPaths.push(imgPath);
      console.log(`[naver] 이미지 다운로드 완료 ${i+1}/${images.length}`);
    } catch (e) {
      console.log(`[naver] 이미지 다운로드 실패 ${i+1}: `, e);
    }
  }

  // slowMo 랜덤화 (인간화)
  const slowMo = Math.floor(Math.random() * 60 + 30); // 30~90ms

  const browser = await chromium.launch({ headless: false, args: LAUNCH_ARGS, slowMo });
  const context = await browser.newContext({ userAgent: UA, viewport: { width: 1280, height: 800 }, locale: "ko-KR", timezoneId: "Asia/Seoul" });
  await applyAntiDetection(context);
  await context.addCookies(cookies);
  const page = await context.newPage();

  try {
    const writeUrl = `https://blog.naver.com/PostWriteForm.naver?blogId=${blogId}`;
    console.log(`[naver] 글쓰기 진입: ${writeUrl}`);
    await page.goto(writeUrl, { waitUntil: "domcontentloaded", timeout: 60000 });

    if (page.url().includes("nidlogin") || page.url().includes("login.naver")) {
      fs.unlinkSync(sp);
      throw new Error("네이버 세션 만료. 계정 재연결 필요");
    }

    await page.waitForLoadState("networkidle", { timeout: 30000 }).catch(() => {});
    await page.waitForTimeout(5000);

    const getFrame = () => {
      const frames = page.frames();
      return frames.find(f => f.name() === "mainFrame")
        ?? frames.find(f => f.url().includes("blog.naver.com"))
        ?? frames[1] ?? null;
    };
    let frame = getFrame();
    if (!frame) {
      for (let i = 0; i < 10; i++) {
        await page.waitForTimeout(1000);
        frame = getFrame();
        if (frame) break;
      }
    }
    if (!frame) throw new Error("mainFrame을 찾을 수 없습니다");

    // 복원 팝업 처리
    try { await frame.click(".se-popup-button-cancel", { timeout: 3000 }); await page.waitForTimeout(1000); } catch {}
    try { const h = await frame.isVisible(".se-help-panel-close-button"); if (h) await frame.click(".se-help-panel-close-button", { timeout: 2000 }); } catch {}

    try {
      await frame.waitForSelector(".se-section-documentTitle, .se-editor, .se-container", { timeout: 40000 });
    } catch {}
    await page.waitForTimeout(3000);

    // ── 제목 입력 ──
    console.log("[naver] 제목 입력...");
    const titleSels = [
      ".se-section-documentTitle .se-text-paragraph span[contenteditable='true']",
      ".se-section-documentTitle [contenteditable='true']",
      ".se-section-documentTitle .se-text-paragraph",
    ];
    let titleInserted = false;
    for (const sel of titleSels) {
      try {
        const el = await frame.$(sel);
        if (el) {
          await frame.click(sel, { timeout: 5000 });
          await page.waitForTimeout(Math.floor(Math.random() * 300 + 200));
          await frame.evaluate((t) => { document.execCommand("selectAll", false); document.execCommand("insertText", false, t); }, title);
          await page.waitForTimeout(Math.floor(Math.random() * 400 + 300));
          titleInserted = true;
          break;
        }
      } catch {}
    }
    if (!titleInserted) {
      await frame.click(".se-section-documentTitle", { timeout: 5000 }).catch(() => {});
      await page.keyboard.type(title, { delay: Math.floor(Math.random() * 60 + 30) });
    }

    // ── 본문 클릭 (편집 영역 진입) ──
    const bodySels = [
      ".se-section-text .se-text-paragraph span[contenteditable='true']",
      ".se-section-text [contenteditable='true']",
      ".se-main-container .se-section:not(.se-section-documentTitle) [contenteditable='true']",
      ".se-component-content [contenteditable='true']",
    ];
    let bodyEl = null;
    for (const sel of bodySels) {
      try { bodyEl = await frame.$(sel); if (bodyEl) { await frame.click(sel, { timeout: 5000 }); break; } } catch {}
    }
    if (!bodyEl) {
      await frame.click(".se-main-container", { timeout: 5000 }).catch(() => {});
    }
    await page.waitForTimeout(500);

    // ── 영상 상단 삽입 ──
    if (videoUrl && videoPosition === "top") {
      await insertVideoToSE4(frame, page, videoUrl);
      await page.keyboard.press("Enter");
      await page.waitForTimeout(500);
    }

    // ── 본문 + 이미지 패턴 삽입 ──
    const contentLines = content.split("\n");
    const thumbImg = localImgPaths[0];     // 썸네일 (별도 처리)
    const bodyImgs = localImgPaths.slice(1); // 본문 이미지들
    const bodyImgCaptions = captions.slice(1);

    if (bodyImgs.length === 0) {
      // 이미지 없음 - 본문 전체 입력
      await humanInsertLines(frame, page, content);
    } else {
      // 패턴에 따라 이미지 삽입 위치 계산
      const positions = calcImagePositions(contentLines, bodyImgs.length, pattern);
      console.log(`[naver] 이미지 패턴 ${pattern}: 삽입 위치 ${positions.join(", ")}번째 줄`);

      let lineIdx = 0;
      let imgIdx = 0;

      for (let pos of [...positions].sort((a,b) => a-b)) {
        // pos까지 텍스트 입력
        const segment = contentLines.slice(lineIdx, pos).join("\n");
        if (segment.trim()) await humanInsertLines(frame, page, segment);
        lineIdx = pos;

        // 이미지 삽입
        if (imgIdx < bodyImgs.length) {
          await page.keyboard.press("Enter");
          await page.waitForTimeout(300);
          await insertImageToSE4(frame, page, bodyImgs[imgIdx], bodyImgCaptions[imgIdx] || "");
          imgIdx++;
          await page.keyboard.press("Enter");
          await page.waitForTimeout(300);
        }
      }

      // 나머지 본문 입력
      const remaining = contentLines.slice(lineIdx).join("\n");
      if (remaining.trim()) await humanInsertLines(frame, page, remaining);
    }

    // ── 영상 중간/하단 삽입 ──
    if (videoUrl && videoPosition === "middle") {
      await page.keyboard.press("Enter");
      await insertVideoToSE4(frame, page, videoUrl);
      await page.keyboard.press("Enter");
    }

    await page.waitForTimeout(1000);

    // ── 발행 1단계 ──
    console.log("[naver] 발행 버튼 클릭...");
    const publishSels = [
      "button.publish_btn__Y8C4q",
      "button[class*='publish_btn']",
      "button[data-testid='seOnePublishBtn']",
      "button:has-text('발행')",
    ];
    let published = false;
    for (const sel of publishSels) {
      try {
        const el = await frame.$(sel);
        if (el) { await frame.click(sel, { timeout: 5000 }); published = true; break; }
      } catch {}
    }
    if (!published) throw new Error("발행 버튼을 찾을 수 없습니다");
    await page.waitForTimeout(Math.floor(Math.random() * 1000 + 2000)); // 랜덤 대기

    // ── 태그 입력 ──
    if (tags.length > 0) {
      try {
        const tagSel = "input.tag_input__YWKIP, input[class*='tag_input'], input[placeholder*='태그']";
        const tagEl = await frame.$(tagSel);
        if (tagEl) {
          await frame.click(tagSel, { timeout: 5000 });
          for (const tag of tags.slice(0, 30)) {
            await frame.fill(tagSel, tag);
            await page.waitForTimeout(Math.floor(Math.random() * 150 + 100));
            await page.keyboard.press("Enter");
            await page.waitForTimeout(Math.floor(Math.random() * 150 + 100));
          }
        }
      } catch (e) { console.log("[naver] 태그 입력 실패 (무시):", e); }
    }

    // ── 최종 발행 (2단계) ──
    console.log("[naver] 최종 발행...");
    const finalSels = [
      "button.confirm_btn__xiHQQ",
      "button[class*='confirm_btn']",
    ];
    let finalPublished = false;
    for (const sel of finalSels) {
      try {
        const el = await frame.$(sel);
        if (el) { await frame.click(sel, { timeout: 8000 }); finalPublished = true; break; }
      } catch {}
    }
    if (!finalPublished) {
      const btns = await frame.$$("button");
      for (const btn of btns.reverse()) {
        const txt = await btn.textContent();
        if (txt?.includes("발행")) { await btn.click(); finalPublished = true; break; }
      }
    }

    // ── 영상 하단 삽입 (발행 전 마지막) ──
    if (videoUrl && videoPosition === "bottom") {
      await page.keyboard.press("End");
      await insertVideoToSE4(frame, page, videoUrl);
    }

    await page.waitForTimeout(5000);

    // URL 추출
    let postUrl = page.url();
    const viewMatch = postUrl.match(/blog\.naver\.com\/[^/]+\/(\d+)/) || postUrl.match(/logNo=(\d+)/);
    if (viewMatch) postUrl = `https://blog.naver.com/${blogId}/${viewMatch[1]}`;

    // 쿠키 갱신
    const newCookies = await context.cookies();
    const session = JSON.parse(fs.readFileSync(sp, "utf-8"));
    session.cookies = newCookies;
    fs.writeFileSync(sp, JSON.stringify(session, null, 2));

    // 임시 이미지 파일 삭제
    localImgPaths.forEach(p => { try { fs.unlinkSync(p); } catch {} });

    await browser.close();
    console.log(`[naver] ✅ 발행 완료: ${postUrl}`);
    return postUrl;
  } catch (e: any) {
    console.error("[naver] ❌ 에러 발생:", e.message);
    try {
      const debugDir = path.join(__dirname, "../debug");
      if (!fs.existsSync(debugDir)) fs.mkdirSync(debugDir, { recursive: true });
      await page.screenshot({ path: path.join(debugDir, `naver_error_${Date.now()}.png`), fullPage: true });
    } catch {}
    localImgPaths.forEach(p => { try { fs.unlinkSync(p); } catch {} });
    await browser.close().catch(() => {});
    throw e;
  }
}
